rules_version = '2';
// 钱箱数据库安全规则：只有已验证的 @takeone51.com Google 账号可以读写。
// 粘贴到 Firebase 控制台 → Firestore Database → 规则 → 发布。
service cloud.firestore {
  match /databases/{database}/documents {

    function isStaff() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@takeone51[.]com$');
    }

    function validTx(d) {
      return d.type in ['in', 'out']
        && d.amount is int && d.amount > 0 && d.amount < 100000000
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.category is string && d.category.size() <= 40
        && d.who is string && d.who.size() <= 40
        && d.note is string && d.note.size() <= 200
        && d.byEmail == request.auth.token.email;
    }

    // 每一笔现金记录：可新增、可删除，不可修改（要改就删掉重记，留痕清楚）
    match /tx/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && validTx(request.resource.data);
      allow delete: if isStaff();
      allow update: if false;
    }

    // 每月收支合计（页面自动维护，用来算余额）
    match /months/{ym} {
      allow read: if isStaff();
      allow write: if isStaff() && ym.matches('^[0-9]{4}-[0-9]{2}$');
    }

    // 期初余额等设置
    match /meta/settings {
      allow read, write: if isStaff();
    }
  }
}
